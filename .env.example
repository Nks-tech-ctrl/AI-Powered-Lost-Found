# FindBack Environment Configuration Template
# Copy this file to .env and provide your environment-specific secrets.
# Never commit real credentials or .env to version control!

# Django Security
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Base Site URL
SITE_URL=http://127.0.0.1:8000

# Database Configuration (Defaults to SQLite for local development)
# DATABASE_URL=postgres://user:password@localhost:5432/findback_db

# Email Gateway Configuration
# Local Development Fallback: console backend prints emails to terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP Example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=notifications@findback.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FindBack Platform <noreply@findback.local>

# Real-Time WebSocket Channel Layer
# Defaults to In-Memory Channel Layer for local development without Redis.
# For production multi-worker deployment:
# REDIS_URL=redis://127.0.0.1:6379/1
